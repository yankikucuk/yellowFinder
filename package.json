{
  "name": "yellowfinder",
  "productName": "yellowFinder",
  "version": "0.1.0",
  "description": "Desktop tool that scans sahibinden.com every hour for owner-posted listings in chosen categories and cities, collects the listed phone numbers and exports them as TXT, CSV or PDF.",
  "private": true,
  "license": "UNLICENSED",
  "author": {
    "name": "Yankı Küçük",
    "email": "kendinikertenkelebek@me.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yankikucuk/yellowFinder.git"
  },
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build:renderer && electron .",
    "start": "electron .",
    "build:renderer": "vite build",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux --publish never",
    "release": "npm run build:renderer && electron-builder --publish always",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "icon": "electron scripts/render-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "vue": "^3.5.45"
  }
}
